{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/auth/(.*)", "destination": "/api/index.py" },
    { "source": "/users/(.*)", "destination": "/api/index.py" },
    { "source": "/university/(.*)", "destination": "/api/index.py" },
    { "source": "/projects/(.*)", "destination": "/api/index.py" },
    { "source": "/tasks/(.*)", "destination": "/api/index.py" },
    { "source": "/agile/(.*)", "destination": "/api/index.py" },
    { "source": "/pm/(.*)", "destination": "/api/index.py" },
    { "source": "/submissions/(.*)", "destination": "/api/index.py" },
    { "source": "/collaboration/(.*)", "destination": "/api/index.py" },
    { "source": "/analytics/(.*)", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/docs", "destination": "/api/index.py" },
    { "source": "/openapi.json", "destination": "/api/index.py" },
    { "source": "/css/(.*)", "destination": "/frontend/css/$1" },
    { "source": "/js/(.*)", "destination": "/frontend/js/$1" },
    { "source": "/devtrack.html", "destination": "/frontend/devtrack.html" },
    { "source": "/", "destination": "/frontend/devtrack.html" }
  ]
}
